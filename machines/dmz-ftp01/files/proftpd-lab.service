[Unit]
Description=ProFTPD 1.3.5 Lab FTP Server (CVE-2015-3306)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/opt/proftpd-1.3.5/sbin/proftpd -c /opt/proftpd-1.3.5/etc/proftpd.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
